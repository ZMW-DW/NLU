        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_devices",
              "list_clients",
              "refresh_code",
              "check_update",
              "show_log",
              "hide_log",
              "show_management",
              "hide_management",
              "show_guide",
              "hide_guide"
            ]
          }
        },
        "required": ["action"]
      }
    }
  }
